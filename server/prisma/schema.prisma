generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== 枚举 =====

enum Role {
  ADMIN        // @deprecated — 迁移后转为 SUPER_ADMIN
  SUPER_ADMIN
  TENANT_ADMIN
  USER
}

enum TenantStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

// ===== 租户与主体 =====

model Tenant {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  domain        String?      @unique
  status        TenantStatus @default(ACTIVE)
  credits       Int          @default(0)
  seatNum       Int          @default(0)
  subjectNum    Int          @default(0)
  contactPerson String
  contactPhone  String       @unique
  contactEmail  String?
  logo          String?
  expireTime    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  subjects              Subject[]
  users                 User[]
  canvases              Canvas[]
  assets                GeneratedAsset[]
  creditTransactions    CreditTransaction[]
  modelPricings         TenantModelPricing[]
  fileCategories        TenantFileCategory[]
  portalBlocks          PortalBlock[]

  @@index([code])
  @@index([status])
}

model Subject {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  status        String   @default("1")
  credits       Int      @default(0)
  contactPerson String?
  contactPhone  String?
  theme         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  users                User[]
  creditTransactions   CreditTransaction[]

  @@index([tenantId])
}

model TenantModelPricing {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  modelId   Int
  model     AiModel @relation(fields: [modelId], references: [id])
  computing Int     // 租户定价，必须 >= 平台 AiModel.costCredits

  @@unique([tenantId, modelId])
}

model TenantFileCategory {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  assets    GeneratedAsset[]

  @@index([tenantId])
}

// ===== 用户（扩展现有，支持三种角色） =====

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  password     String
  role         Role     @default(USER)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  subjectId    String?
  subject      Subject? @relation(fields: [subjectId], references: [id])
  tokenVersion Int      @default(0)
  credits      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  canvases            Canvas[]
  generatedAssets     GeneratedAsset[]
  creditTransactions  CreditTransaction[]

  @@index([tenantId])
  @@index([subjectId])
}

// ===== AI 模型 =====

model AiModel {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  provider    String   @default("sophnet")
  baseUrl     String   @default("https://www.sophnet.com/api/open-apis/projects/easyllms")
  apiKey      String
  modelName   String
  category    String   @default("image")
  enabled     Boolean  @default(true)
  description String?
  costCredits Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantPricings TenantModelPricing[]
}

// ===== 画布 =====

model Canvas {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?
  tenant    Tenant?          @relation(fields: [tenantId], references: [id])
  name      String           @default("未命名画布")
  nodes     Json             @default("[]")
  edges     Json             @default("[]")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  assets    GeneratedAsset[]

  @@index([userId])
  @@index([tenantId])
}

// ===== 素材 =====

model GeneratedAsset {
  id         Int      @id @default(autoincrement())
  canvasId   Int?
  canvas     Canvas?  @relation(fields: [canvasId], references: [id], onDelete: SetNull)
  nodeId     String?
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  categoryId String?
  category   TenantFileCategory? @relation(fields: [categoryId], references: [id])
  filename   String
  mimeType   String   @default("image/png")
  prompt     String?
  modelName  String?
  createdAt  DateTime @default(now())
  deletedAt  DateTime?

  @@index([canvasId])
  @@index([nodeId])
  @@index([userId])
  @@index([tenantId])
}

// ===== 算力流水（统一记录所有层级） =====

model CreditTransaction {
  id             Int      @id @default(autoincrement())
  amount         Int      // 正=入账，负=出账
  type           String   // TENANT_RECHARGE | SUBJECT_ALLOCATE | USER_ALLOCATE | GENERATION_DEDUCTION | GENERATION_REFUND | ADMIN_GRANT | ADMIN_REVOKE
  userId         Int?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id])
  relatedModelId Int?
  description    String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@index([subjectId, createdAt])
}

// ===== 视频生成异步任务 =====

model VideoTask {
  id           Int      @id @default(autoincrement())
  taskId       String   @unique
  userId       Int
  modelId      Int
  canvasId     Int
  nodeId       String?
  prompt       String
  duration     Int      @default(5)
  status       String   @default("running")
  videoUrl     String?
  lastFrameUrl String?
  costCredits  Int
  refunded     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ===== 门户区块装修 =====

model PortalBlock {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  type      String   // "hero" | "banner" | "features" | "models" | "stats" | "cta" | "divider"
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, sortOrder])
}
